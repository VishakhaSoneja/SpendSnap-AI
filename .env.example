# Server
PORT=5000
NODE_ENV=development

# SQLite database file (relative to project root)
DB_PATH=data/spendsnap.sqlite

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# CORS (comma-separated list, or * to allow all)
# Dev default (when unset): http://localhost:5000, http://127.0.0.1:5000,
# http://localhost:3000, http://127.0.0.1:3000, http://localhost:5173, http://127.0.0.1:5173
# Production: always set explicitly to your deployed frontend origin(s).
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20
